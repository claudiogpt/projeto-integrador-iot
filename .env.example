# Copie para .env e ajuste. O .env NUNCA é versionado (ver .gitignore).
# Credenciais de DESENVOLVIMENTO LOCAL apenas.

# --- Object storage (S3-compatible / SeaweedFS) ---
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=acmetech-dev
S3_SECRET_KEY=troque-este-segredo-local
S3_BUCKET=lakehouse

# --- NoSQL (catálogo de máquinas/sensores) ---
MONGO_USER=acmetech
MONGO_PASSWORD=troque-esta-senha-local
MONGO_DB=acmetech
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017/?authSource=admin
